# Project2AK — copy to .env.local and fill in.

# Supabase project. Both of these are safe in the browser bundle: the anon key
# is powerless without a session because every table is RLS-scoped to
# auth.uid(). That is why RLS is not optional here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Receipt extraction. Server-side only — never expose this to the browser.
# Without it the app still works: capture, storage, and manual entry all
# function, and the review screen drops straight to the manual form.
ANTHROPIC_API_KEY=

# Where magic links come back to. Set to the deployed origin in production;
# Vercel sets VERCEL_URL automatically, this is the local override.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
